<UserControl
    x:Class="QuranKemenag.Controls.AyatCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:font="using:QuranKemenag.Helpers.Font">

    <!-- ===========================================================
         AYAT CARD
         =========================================================== -->

    <Border
        x:Name="PART_Border"
        Margin="12,8"
        Padding="12"
        Background="Transparent"
        Tapped="PART_Border_Tapped">

        <Grid>

            <Grid.RowDefinitions>

                <!-- Header Surah + Panel Arab -->
                <RowDefinition Height="Auto"/>

                <!-- Transliterasi -->
                <RowDefinition Height="Auto"/>

                <!-- Terjemahan -->
                <RowDefinition Height="Auto"/>

                <!-- Catatan -->
                <RowDefinition Height="Auto"/>

                <!-- Toolbar -->
                <RowDefinition Height="Auto"/>

                <!-- Divider -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ===========================================================
                 HEADER SURAH + PANEL ARAB
                 =========================================================== -->

            <StackPanel
                Grid.Row="0"
                Spacing="12">


                <!-- =======================================================
                     HEADER SURAH
                     ======================================================= -->

                <StackPanel
                    x:Name="PART_SurahHeader"
                    Visibility="Collapsed"
                    Margin="0,8,0,12"
                    Spacing="10">


                    <!-- ===================================================
                         ILUMINASI HEADER SURAH
                         =================================================== -->

                    <Grid
                        Height="125"
                        HorizontalAlignment="Stretch">

                        <!--
                            Gambar frame header Surah.
                            File ini sudah ada di project Anda.
                        -->

                        <Image
                            Source="ms-appx:///Assets/Illumination/Standard/surah-header.png"
                            Stretch="Fill"/>


                        <!-- =================================================
                             TEKS DI ATAS ILUMINASI
                             ================================================= -->

                        <Grid
                            Margin="30,8">

                            <Grid.ColumnDefinitions>

                                <!-- Jumlah ayat -->
                                <ColumnDefinition Width="1.2*"/>

                                <!-- Nama Surah -->
                                <ColumnDefinition Width="2.5*"/>

                                <!-- Makkiyah / Madaniyah -->
                                <ColumnDefinition Width="1.2*"/>

                            </Grid.ColumnDefinitions>


                            <!-- =============================================
                                 JUMLAH AYAT
                                 ============================================= -->

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding SurahTotalAyahArabic}"
                                FlowDirection="RightToLeft"
                                FontSize="24"
                                TextAlignment="Center"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>


                            <!-- =============================================
                                 NAMA SURAH
                                 ============================================= -->

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding SurahArabicName}"
                                FlowDirection="RightToLeft"
                                FontFamily="ms-appx:///Assets/Fonts/LPMQ IsepMisbah.ttf#LPMQ Isep Misbah"
                                FontSize="34"
                                FontWeight="SemiBold"
                                TextAlignment="Center"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>


                            <!-- =============================================
                                 KATEGORI SURAH
                                 ============================================= -->

                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding SurahCategoryArabic}"
                                FontFamily="ms-appx:///Assets/Fonts/LPMQ IsepMisbah.ttf#LPMQ Isep Misbah"
                                FlowDirection="RightToLeft"
                                FontSize="22"
                                TextAlignment="Center"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Grid>

                    </Grid>


                    <!-- ===================================================
                         BISMILLAH
                         =================================================== -->

                    <TextBlock
                        x:Name="PART_Bismillah"
                        Text="بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
                        FontFamily="ms-appx:///Assets/Fonts/LPMQ IsepMisbah.ttf#LPMQ Isep Misbah"
                        FlowDirection="RightToLeft"
                        FontSize="40"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,24"/>

                </StackPanel>


                <!-- =======================================================
                     PANEL ARAB
                     ======================================================= -->

                <Border
                    Padding="28"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>

                            <!-- Ayat -->
                            <RowDefinition Height="Auto"/>

                            <!-- Bahasa Isyarat -->
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- =================================================
                             AYAT
                             ================================================= -->
                        <Grid
    x:Name="PART_AyatArea"
    Grid.Row="0"
                            SizeChanged="PART_AyatArea_SizeChanged">

                            <Grid.ColumnDefinitions>
                                <!-- Nomor ayat -->
                                <ColumnDefinition Width="Auto"/>

                                <!-- Teks Arab -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- =================================================
         NOMOR AYAT
         ================================================= -->

                            <Canvas
        x:Name="PART_AyatNumberCanvas"
        Grid.Column="0"
        Width="38"
        HorizontalAlignment="Left"
        VerticalAlignment="Stretch"
        SizeChanged="PART_AyatNumberCanvas_SizeChanged"
        IsHitTestVisible="False">

                                <Border
            x:Name="PART_AyatNumber"
            Width="38"
            Height="38"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom">

                                    <Border.Background>
                                        <ImageBrush
                    ImageSource="/Resources/Images/bingkai-nomor-ayat.png"
                    Stretch="Uniform"/>
                                    </Border.Background>

                                    <TextBlock
                Text="{Binding ArabicAyatNumber}"
                FontSize="13"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                FlowDirection="LeftToRight"/>
                                </Border>

                            </Canvas>


                            <!-- =================================================
         TEKS AYAT
         ================================================= -->

                            <TextBlock
        x:Name="PART_TextTeks"
        Grid.Column="1"
        Text="{Binding DisplayText}"
        FontSize="{Binding ArabicFontSize, ElementName=Root}"
        LineHeight="78"
        TextWrapping="Wrap"
        FlowDirection="RightToLeft"
        TextAlignment="Left"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        font:FontHelper.AutoFont="True"/>

                            <Canvas
    x:Name="PART_HandwrittenCanvas"
    Grid.Column="1"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    Visibility="Collapsed"
    IsHitTestVisible="False" />

                        </Grid>


                        <!-- =================================================
                             BAHASA ISYARAT
                             ================================================= -->

                        <Border
                            x:Name="PART_IsyaratContainer"
                            Grid.Row="1"
                            Margin="0,24,0,0"
                            Padding="18"
                            CornerRadius="10"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            Visibility="Collapsed">

                            <StackPanel>

                                <!-- Judul -->
                                <TextBlock
                                    Text="Bahasa Isyarat"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,10"/>


                                <!-- Data Isyarat -->
                                <TextBlock
                                    x:Name="PART_Isyarat"
                                    Text="{Binding Isyarat}"
                                    FontSize="{Binding IsyaratFontSize, ElementName=Root}"
                                    LineHeight="36"
                                    TextWrapping="Wrap"
                                    TextAlignment="Right"
                                    FlowDirection="RightToLeft"
                                    HorizontalAlignment="Stretch"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>

            </StackPanel>


            <!-- ===========================================================
                 TRANSLITERASI
                 =========================================================== -->

            <TextBlock
                Grid.Row="1"
                Margin="0,18,0,0"
                Visibility="Collapsed"/>


            <!-- ===========================================================
                 TERJEMAHAN
                 =========================================================== -->

            <Border
                x:Name="PART_TranslationContainer"
                Grid.Row="2"
                Margin="0,20,0,0"
                Padding="20"
                CornerRadius="10"
                Background="{ThemeResource ControlAltFillColorSecondaryBrush}">

                <StackPanel>

                    <TextBlock
                        Text="Terjemahan"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Margin="0,0,0,10"/>


                    <TextBlock
                        x:Name="PART_Translation"
                        Text="{Binding Terjemahan}"
                        FontSize="{Binding TranslationFontSize, ElementName=Root}"
                        LineHeight="30"
                        TextWrapping="Wrap"
                        TextAlignment="Left"
                        HorizontalAlignment="Stretch"/>

                </StackPanel>

            </Border>


            <!-- ===========================================================
                 CATATAN KAKI
                 =========================================================== -->

            <Border
                x:Name="PART_FootnoteContainer"
                Grid.Row="3"
                Margin="0,12,0,0"
                Padding="20"
                CornerRadius="10"
                Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

                <StackPanel>

                    <TextBlock
                        Text="Catatan Kaki"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Margin="0,0,0,10"/>


                    <TextBlock
                        x:Name="PART_Footnote"
                        Text="{Binding TextFn}"
                        FontSize="15"
                        LineHeight="26"
                        TextWrapping="Wrap"
                        TextAlignment="Left"
                        HorizontalAlignment="Stretch"/>

                </StackPanel>

            </Border>


            <!-- ===========================================================
                 DIVIDER
                 =========================================================== -->

            <Border
                Grid.Row="5"
                Margin="0,24,0,0"
                Height="6"
                Visibility="Collapsed"/>


            <!-- ===========================================================
                 AYAT ACTION BAR
                 =========================================================== -->

            <Border
                x:Name="PART_ActionBar"
                Grid.Row="4"
                Margin="0,12,0,0"
                Padding="0,8,0,0"
                BorderBrush="{StaticResource NeutralBorderBrush}"
                BorderThickness="0,1,0,0"
                HorizontalAlignment="Stretch">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <!-- Salin -->
                        <ColumnDefinition Width="Auto"/>

                        <!-- Spacer -->
                        <ColumnDefinition Width="*"/>

                        <!-- Bookmark -->
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <!-- =====================================================
                         SALIN
                         ===================================================== -->

                    <Button
                        x:Name="PART_CopyButton"
                        Grid.Column="0"
                        MinWidth="90"
                        Height="36"
                        Content="📋 Salin"
                        Click="PART_CopyButton_Click"
                        ToolTipService.ToolTip="Salin ayat"/>


                    <!-- =====================================================
                         SPACER
                         ===================================================== -->

                    <Grid
                        Grid.Column="1"/>


                    <!-- =====================================================
                         BOOKMARK
                         ===================================================== -->

                    <Button
                        x:Name="PART_BookmarkButton"
                        Grid.Column="2"
                        MinWidth="110"
                        Height="36"
                        Content="🔖 Bookmark"
                        ToolTipService.ToolTip="Bookmark ayat"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>