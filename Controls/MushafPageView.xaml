<UserControl
    x:Class="QuranKemenag.Views.Controls.MushafPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <Grid
            HorizontalAlignment="Center"
            Padding="24,20">

            <!-- =================================================
                 PAGE CANVAS
                 ================================================= -->

            <Border
                x:Name="PART_PageBorder"
                Width="760"
                MinHeight="1040"
                Background="#FFFDF8"
                BorderBrush="{StaticResource LpmqGreenBrush}"
                BorderThickness="3"
                Padding="18">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- HEADER -->
                        <RowDefinition
                            Height="Auto" />

                        <!-- CONTENT -->
                        <RowDefinition
                            Height="*" />

                        <!-- FOOTER -->
                        <RowDefinition
                            Height="Auto" />

                    </Grid.RowDefinitions>


                    <!-- =================================================
                         HEADER
                         KIRI  = NAMA SURAT
                         KANAN = JUZ
                         ================================================= -->

                    <Grid
                        Grid.Row="0"
                        Margin="14,4,14,18"
                        FlowDirection="LeftToRight">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition
                                Width="*" />

                            <ColumnDefinition
                                Width="*" />

                        </Grid.ColumnDefinitions>


                        <!-- NAMA SURAT -->

                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding SurahArabicName}"
                            FlowDirection="RightToLeft"
                            FontSize="22"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />


                        <!-- JUZ -->

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding JuzDisplayText}"
                            FlowDirection="RightToLeft"
                            FontSize="22"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />

                    </Grid>


                    <!-- =================================================
                         CONTENT FRAME
                         ================================================= -->

                    <Border
                        x:Name="PART_ContentFrame"
                        Grid.Row="1"
                        BorderBrush="#D9D4B8"
                        BorderThickness="1"
                        Padding="28,24">

                        <StackPanel
                            x:Name="PART_ContentHost"
                            Spacing="0">

                            <!--
                                Mode Computer Font (KodeFont == 0).
                                TIDAK DIUBAH - tetap RichTextBlock +
                                Paragraph + Run + TextAlignment.Justify,
                                persis seperti sebelumnya.
                            -->

                            <RichTextBlock
                                x:Name="PART_RichText"
                                FlowDirection="RightToLeft"
                                FontSize="42"
                                TextAlignment="Justify"
                                TextWrapping="Wrap"
                                LineStackingStrategy="BlockLineHeight"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Visibility="Collapsed" />

                            <!--
                                Mode Handwritten (KodeFont != 0).
                                Setiap PUA glyph ditempatkan manual oleh
                                HandwrittenLayoutEngine sebagai satu
                                TextBlock berposisi Canvas.Left/Canvas.Top
                                - tidak ada Unicode BiDi maupun
                                TextAlignment.Justify yang terlibat.
                            -->

                            <Canvas
                                x:Name="PART_HandwrittenCanvas"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Visibility="Collapsed" />

                        </StackPanel>

                    </Border>


                    <!-- =================================================
                         FOOTER
                         ================================================= -->

                    <Grid
                        Grid.Row="2"
                        Margin="14,18,14,4"
                        MinHeight="42">

                        <!--
                            Slot untuk teks Arab footer.
                            Nanti dapat diganti dengan asset
                            iluminasi/footer.
                        -->

                        <TextBlock
                            x:Name="PART_FooterText"
                            Text="{Binding FooterArabicText}"
                            FlowDirection="RightToLeft"
                            FontSize="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />


                        <!-- NOMOR HALAMAN -->

                        <TextBlock
                            x:Name="PART_PageNumber"
                            Text="{Binding PageNumber}"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,22,0,0" />

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>