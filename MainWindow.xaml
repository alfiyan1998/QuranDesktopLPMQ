<Window
    x:Class="QuranKemenag.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:QuranKemenag.Views">

    <Grid Background="{StaticResource NeutralBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Toolbar -->
            <RowDefinition Height="*" />      <!-- Sidebar | Mushaf Viewer | Feature Panel -->
            <RowDefinition Height="Auto" />   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ===================== TOOLBAR ===================== -->
        <views:ToolbarView
            x:Name="Toolbar"
            Grid.Row="0"
            SidebarToggleRequested="Toolbar_SidebarToggleRequested"
            PanelToggleRequested="Toolbar_PanelToggleRequested" />

        <!-- ===================== KONTEN TENGAH ===================== -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition
            x:Name="SidebarColumn"
            Width="220" />

                <ColumnDefinition
            Width="*" />

                <ColumnDefinition
            x:Name="PanelColumn"
            Width="300" />

            </Grid.ColumnDefinitions>


            <!-- =====================================================
         SIDEBAR
         ===================================================== -->

            <views:SidebarView
        x:Name="Sidebar"
        Grid.Column="0" />


            <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

            <Grid
        x:Name="ContentHost"
        Grid.Column="1">

                <views:HomeView
            x:Name="HomeView"
            Visibility="Collapsed" />

                <views:SurahView
            x:Name="SurahView"
            Visibility="Collapsed" />

                <views:JuzView
                x:Name="JuzView"
                Visibility="Collapsed" />
                <!-- diubah SEMENTARA dari Visible -->

                <views:ReaderView
            x:Name="ReaderView"
            Visibility="Collapsed" />

                <!-- ===== SEMENTARA untuk uji STEP 6, akan dirapikan di STEP 8/9 ===== -->
                <views:MushafPerHalamanView
        x:Name="MushafPerHalamanView"
        Visibility="Collapsed" />

             

            </Grid>


            <!-- =====================================================
         FEATURE PANEL
         ===================================================== -->

            <views:FeaturePanelView
        x:Name="FeaturePanel"
        Grid.Column="2" />

        </Grid>

        <!-- ===================== STATUS BAR ===================== -->
        <views:StatusBarView
            Grid.Row="2" />

    </Grid>
</Window>
