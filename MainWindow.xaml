<Window
    x:Class="QuranKemenag.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:QuranKemenag.Views">

    <Grid Background="{StaticResource NeutralBackgroundBrush}">

        <!-- =====================================================
             ROW UTAMA
             ===================================================== -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Toolbar -->

            <RowDefinition Height="*" />
            <!-- Content -->

            <RowDefinition Height="Auto" />
            <!-- Status Bar -->
        </Grid.RowDefinitions>


        <!-- =====================================================
             KOLOM UTAMA
             ===================================================== -->
        <Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <ColumnDefinition
                x:Name="SidebarColumn"
                Width="220" />

            <!-- CONTENT -->
            <ColumnDefinition
                Width="*" />

            <!-- FEATURE PANEL -->
            <ColumnDefinition
                x:Name="PanelColumn"
                Width="300" />

        </Grid.ColumnDefinitions>
        


        <!-- =====================================================
             SIDEBAR
             ===================================================== -->

        <views:SidebarView
            x:Name="Sidebar"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0" />


        <!-- =====================================================
             TOOLBAR
             ===================================================== -->

        <views:ToolbarView
            x:Name="Toolbar"
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            SidebarToggleRequested="Toolbar_SidebarToggleRequested"
            PanelToggleRequested="Toolbar_PanelToggleRequested" />


        <!-- =====================================================
             MAIN CONTENT
             ===================================================== -->

        <Grid
            x:Name="ContentHost"
            Grid.Row="1"
            Grid.Column="1">

            <!-- HOME -->

            <views:HomeView
                x:Name="HomeView"
                Visibility="Collapsed" />


            <!-- SURAH -->

            <views:SurahView
                x:Name="SurahView"
                Visibility="Collapsed" />


            <!-- JUZ -->

            <views:JuzView
                x:Name="JuzView"
                Visibility="Collapsed" />

            <!-- BOOKMARK -->

            <views:BookmarkView
                x:Name="BookmarkView"
                Visibility="Collapsed" />


            <!-- READER -->

            <views:ReaderView
                x:Name="ReaderView"
                Visibility="Collapsed" />


            <!-- MUSHAF PER HALAMAN -->

            <views:MushafPerHalamanView
                x:Name="MushafPerHalamanView"
                Visibility="Collapsed" />

        </Grid>


        <!-- =====================================================
             FEATURE PANEL
             ===================================================== -->

        <views:FeaturePanelView
            x:Name="FeaturePanel"
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2" />


        <!-- =====================================================
             STATUS BAR
             ===================================================== -->

        <views:StatusBarView
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3" />

    </Grid>

</Window>