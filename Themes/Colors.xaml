<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palet warna identitas LPMQ (Lajnah Pentashihan Mushaf Al-Qur'an).
        Warna hijau dipilih sebagai warna utama sesuai identitas visual LPMQ.
        Semua warna didefinisikan di sini agar mudah diubah di satu tempat
        tanpa harus menyentuh file XAML lain.
    -->

    <!-- Warna Hijau Utama (Primary) -->
    <Color x:Key="LpmqGreenDarkColor">#0B4D2C</Color>
    <Color x:Key="LpmqGreenColor">#0F6B3C</Color>
    <Color x:Key="LpmqGreenLightColor">#3F9B6B</Color>
    <Color x:Key="LpmqGreenSoftColor">#E6F3EC</Color>

    <!-- Warna Netral -->
    <Color x:Key="NeutralBackgroundColor">#FAFAFA</Color>
    <Color x:Key="NeutralSurfaceColor">#FFFFFF</Color>
    <Color x:Key="NeutralBorderColor">#E0E0E0</Color>
    <Color x:Key="NeutralTextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="NeutralTextSecondaryColor">#6B6B6B</Color>

    <!-- Warna Aksen (untuk status, badge, dsb — dipakai di tahap selanjutnya) -->
    <Color x:Key="AccentGoldColor">#C9A24B</Color>

</ResourceDictionary>
