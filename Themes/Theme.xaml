<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        File ini berisi SolidColorBrush yang diturunkan dari Colors.xaml,
        serta Style dasar untuk Fluent Design (sudut membulat, shadow ringan, spacing).
        ViewModel/Views nanti cukup memakai brush ini (misal: {StaticResource LpmqGreenBrush}),
        bukan menulis kode warna hex secara langsung.
    -->

    <!-- ===================== BRUSH ===================== -->
    <SolidColorBrush x:Key="LpmqGreenDarkBrush" Color="{StaticResource LpmqGreenDarkColor}" />
    <SolidColorBrush x:Key="LpmqGreenBrush" Color="{StaticResource LpmqGreenColor}" />
    <SolidColorBrush x:Key="LpmqGreenLightBrush" Color="{StaticResource LpmqGreenLightColor}" />
    <SolidColorBrush x:Key="LpmqGreenSoftBrush" Color="{StaticResource LpmqGreenSoftColor}" />

    <SolidColorBrush x:Key="NeutralBackgroundBrush" Color="{StaticResource NeutralBackgroundColor}" />
    <SolidColorBrush x:Key="NeutralSurfaceBrush" Color="{StaticResource NeutralSurfaceColor}" />
    <SolidColorBrush x:Key="NeutralBorderBrush" Color="{StaticResource NeutralBorderColor}" />
    <SolidColorBrush x:Key="NeutralTextPrimaryBrush" Color="{StaticResource NeutralTextPrimaryColor}" />
    <SolidColorBrush x:Key="NeutralTextSecondaryBrush" Color="{StaticResource NeutralTextSecondaryColor}" />

    <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGoldColor}" />

    <!-- ===================== UKURAN & SPACING (Fluent Design) ===================== -->
    <x:Double x:Key="AppCornerRadiusValue">8</x:Double>
    <CornerRadius x:Key="AppCornerRadius">8</CornerRadius>
    <Thickness x:Key="AppContentPadding">16</Thickness>

    <!-- ===================== STYLE DASAR ===================== -->

    <!-- Style untuk kartu/panel dengan sudut membulat + shadow ringan (Fluent Design) -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeutralSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NeutralBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource AppContentPadding}" />
    </Style>

    <!-- Style judul halaman -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NeutralTextPrimaryBrush}" />
    </Style>

    <!-- Style teks sekunder/keterangan -->
    <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource NeutralTextSecondaryBrush}" />
    </Style>

    <!-- Highlight resources for selected Ayat -->
    <SolidColorBrush x:Key="HighlightBackgroundBrush" Color="#FFF3F9F3" />
    <SolidColorBrush x:Key="HighlightBorderBrush" Color="#0F6B3C" />
    <Thickness x:Key="HighlightBorderThickness">2</Thickness>


</ResourceDictionary>
