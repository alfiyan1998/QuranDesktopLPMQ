<UserControl
    x:Class="QuranKemenag.Views.BookmarkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                Text="Bookmark"
                FontSize="24"
                FontWeight="SemiBold" />

            <TextBlock
                Text="Ayat yang Anda simpan"
                FontSize="13"
                Opacity="0.6"
                Margin="0,4,0,0" />
            
            <TextBlock
                x:Name="BookmarkCountText"
                Text="0 bookmark"
                FontSize="12"
                Opacity="0.5"
                Margin="0,4,0,0" />

            <TextBox
                x:Name="BookmarkSearchBox"
                PlaceholderText="Cari bookmark..."
                Margin="0,12,0,0"
                TextChanged="BookmarkSearchBox_TextChanged" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,10,0,0">

                <TextBlock
                    Text="Filter:"
                    VerticalAlignment="Center"
                    FontSize="13" />

                <ComboBox
                    x:Name="BookmarkFilterComboBox"
                    Width="170">

                    <ComboBoxItem
                        Content="Semua"
                        Tag="all"
                        IsSelected="True" />

                    <ComboBoxItem
                        Content="Memiliki catatan"
                        Tag="with-note" />

                    <ComboBoxItem
                        Content="Tanpa catatan"
                        Tag="without-note" />
                </ComboBox>

                <TextBlock
                    Text="Urutkan:"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Margin="12,0,0,0" />

                <ComboBox
                    x:Name="BookmarkSortComboBox"
                    Width="170">

                    <ComboBoxItem
                        Content="Terbaru"
                        Tag="newest"
                        IsSelected="True" />

                    <ComboBoxItem
                        Content="Terlama"
                        Tag="oldest" />

                    <ComboBoxItem
                        Content="Surah → Ayat"
                        Tag="surah" />
                </ComboBox>

            </StackPanel>

        </StackPanel>

        <!-- Daftar Bookmark -->
        <!-- Daftar Bookmark -->
        <Grid Grid.Row="1">

            <ListView
        x:Name="BookmarkListView"
        SelectionMode="None">

                <ListView.ItemTemplate>
                    <DataTemplate>

                        <Border
                    Padding="16"
                    Margin="0,0,0,10"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                Text="{Binding DisplayText}"
                                FontSize="16"
                                FontWeight="SemiBold" />

                                    <TextBlock
                                Text="{Binding Note}"
                                FontSize="13"
                                Opacity="0.7"
                                Margin="0,6,0,0"
                                TextWrapping="Wrap" />

                                    <TextBlock
                                Text="{Binding CreatedAt}"
                                FontSize="11"
                                Opacity="0.5"
                                Margin="0,8,0,0" />

                                </StackPanel>

                                <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">

                                    <Button
                                Content="Buka"
                                Tag="{Binding}"
                                Click="OpenBookmarkButton_Click" />

                                    <Button
                                Content="Edit"
                                Tag="{Binding}"
                                Click="EditBookmarkButton_Click" />

                                    <Button
                                Content="Hapus"
                                Tag="{Binding}"
                                Click="DeleteBookmarkButton_Click" />

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>


            <!-- Tampilan ketika belum ada bookmark -->
            <StackPanel
        x:Name="EmptyBookmarkPanel"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="8"
        Visibility="Collapsed">

                <TextBlock
            Text="🔖"
            FontSize="42"
            HorizontalAlignment="Center" />

                <TextBlock
            Text="Belum ada bookmark"
            FontSize="18"
            FontWeight="SemiBold"
            HorizontalAlignment="Center" />

                <TextBlock
            Text="Tandai ayat yang ingin Anda simpan untuk dibaca kembali."
            FontSize="13"
            Opacity="0.6"
            TextAlignment="Center"
            TextWrapping="Wrap"
            MaxWidth="360" />

            </StackPanel>

            <StackPanel
    x:Name="NoSearchResultPanel"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Spacing="8"
    Visibility="Collapsed">

                <TextBlock
        Text="🔎"
        FontSize="42"
        HorizontalAlignment="Center" />

                <TextBlock
        Text="Bookmark tidak ditemukan"
        FontSize="18"
        FontWeight="SemiBold"
        HorizontalAlignment="Center" />

                <TextBlock
        Text="Coba gunakan kata kunci atau filter yang berbeda."
        FontSize="13"
        Opacity="0.6"
        TextAlignment="Center"
        TextWrapping="Wrap"
        MaxWidth="360" />

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>