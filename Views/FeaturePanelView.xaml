<UserControl
    x:Class="QuranKemenag.Views.FeaturePanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource NeutralSurfaceBrush}"
            BorderBrush="{StaticResource NeutralBorderBrush}"
            BorderThickness="1,0,0,0">
        <ScrollViewer Padding="12">
            <StackPanel Spacing="8">

                <TextBlock Text="Feature Panel"
                           Style="{StaticResource PageTitleTextStyle}"
                           FontSize="16"
                           Margin="0,0,0,4" />

                <!-- Section: Copy 
                <Expander Header="Copy" HorizontalAlignment="Stretch" IsExpanded="True">
                    <TextBlock Text="Komponen Copy akan ditambahkan di Tahap 9"
                               Style="{StaticResource SubtleTextStyle}"
                               TextWrapping="Wrap" />
                </Expander>
                
                -->

                <!-- Section: Search the Ayahs 
                <Expander Header="Search the Ayahs" HorizontalAlignment="Stretch">
                    <TextBlock Text="Komponen Search akan ditambahkan di Tahap 10"
                               Style="{StaticResource SubtleTextStyle}"
                               TextWrapping="Wrap" />
                </Expander>
                -->

                <!-- Section: Advanced Search 
                <Expander Header="Advanced Search" HorizontalAlignment="Stretch">
                    <TextBlock Text="Komponen Advanced Search akan ditambahkan di Tahap 10"
                               Style="{StaticResource SubtleTextStyle}"
                               TextWrapping="Wrap" />
                </Expander>
                -->

                <!-- Section: Tampilan -->

                <Expander
                    Header="Tampilan"
                    HorizontalAlignment="Stretch"
                    IsExpanded="True">



                    <Grid x:Name="ContentRoot">

                        <ContentControl x:Name="SettingsHost"
                        IsTabStop="False"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top">

                            <StackPanel
                            x:Name="SettingsPanel"
                            Spacing="16"
                            Padding="4,8,4,12">

                        <!-- =====================================================
                         PRESET TAMPILAN
                         ===================================================== -->

                        <StackPanel
                             Spacing="8">

                            <TextBlock
                                Text="Preset Tampilan"
                                FontWeight="SemiBold" />

                            <ComboBox
                                x:Name="PresetComboBox"
                                SelectedIndex="0"
                                SelectionChanged="PresetComboBox_SelectionChanged"
                                HorizontalAlignment="Stretch">

                                <ComboBoxItem Content="Standar" />
                                <ComboBoxItem Content="Nyaman" />
                                <ComboBoxItem Content="Besar" />

                            </ComboBox>

                            <TextBlock
        Text="Preset mengatur ukuran Arab, terjemahan, dan Bahasa Isyarat sekaligus."
        Style="{StaticResource SubtleTextStyle}"
        TextWrapping="Wrap" />

                        </StackPanel>


                        <!-- Terjemahan + Catatan Kaki -->

                        <StackPanel Spacing="4">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="2">

                                    <TextBlock
                                        Text="Terjemahan"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Style="{StaticResource SubtleTextStyle}"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding ShowTranslation, Mode=TwoWay}"
                                    IsEnabled="{Binding IsAyatView}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />

                            </Grid>

                        </StackPanel>


                        <!-- Bahasa Isyarat -->

                        <StackPanel Spacing="4">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="2">

                                    <TextBlock
                                        Text="Bahasa Isyarat"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Style="{StaticResource SubtleTextStyle}"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding ShowIsyarat, Mode=TwoWay}"
                                    IsEnabled="{Binding IsAyatView}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />

                            </Grid>

                        </StackPanel>

                        <!-- =====================================================
                         UKURAN TEKS ARAB
                         ===================================================== -->

                        <StackPanel
                            Spacing="8"
                            Margin="0,4,0,0">

                            <TextBlock
                                Text="Ukuran Teks Arab"
                                FontWeight="SemiBold" />

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Slider
                                    Grid.Column="0"
                                    Minimum="28"
                                    Maximum="64"
                                    Value="{Binding ArabicFontSize, Mode=TwoWay}"
                                    StepFrequency="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding ArabicFontSize, Mode=OneWay}"
                                    Width="42"
                                    Margin="10,0,0,0"
                                    HorizontalTextAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />

                            </Grid>

                            <TextBlock
                                    Text="Atur ukuran teks Arab sesuai kenyamanan membaca."
                                    Style="{StaticResource SubtleTextStyle}"
                                    TextWrapping="Wrap" />

                        </StackPanel>

                        <!-- =====================================================
 UKURAN TEKS TERJEMAHAN
 ===================================================== -->

                        <StackPanel
Spacing="8"
Margin="0,4,0,0">

                            <TextBlock
    Text="Ukuran Teks Terjemahan"
    FontWeight="SemiBold" />

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Slider
        Grid.Column="0"
        Minimum="14"
        Maximum="28"
        Value="{Binding TranslationFontSize, Mode=TwoWay}"
        IsEnabled="{Binding IsAyatView}"
        StepFrequency="1"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center" />

                                <TextBlock
        Grid.Column="1"
        Text="{Binding TranslationFontSize, Mode=OneWay}"
        Width="42"
        Margin="10,0,0,0"
        HorizontalTextAlignment="Center"
        VerticalAlignment="Center"
        FontWeight="SemiBold" />

                            </Grid>

                            <TextBlock
    Text="Atur ukuran teks terjemahan sesuai kenyamanan membaca."
    Style="{StaticResource SubtleTextStyle}"
    TextWrapping="Wrap" />

                        </StackPanel>

                        <!-- =====================================================
     UKURAN TEKS BAHASA ISYARAT
     ===================================================== -->

                        <StackPanel
    Spacing="8"
    Margin="0,4,0,0">

                            <TextBlock
        Text="Ukuran Teks Bahasa Isyarat"
        FontWeight="SemiBold"
        TextWrapping="Wrap" />

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Slider
            Grid.Column="0"
            Minimum="16"
            Maximum="32"
            Value="{Binding IsyaratFontSize, Mode=TwoWay}"
            IsEnabled="{Binding IsAyatView}"
            StepFrequency="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center" />

                                <TextBlock
            Grid.Column="1"
            Text="{Binding IsyaratFontSize, Mode=OneWay}"
            Width="42"
            Margin="10,0,0,0"
            HorizontalTextAlignment="Center"
            VerticalAlignment="Center"
            FontWeight="SemiBold" />

                            </Grid>

                            <TextBlock
        Text="Atur ukuran teks Bahasa Isyarat sesuai kenyamanan membaca."
        Style="{StaticResource SubtleTextStyle}"
        TextWrapping="Wrap" />

                        </StackPanel>

                    <!--</StackPanel>

                </Expander> -->
                            
                            <!--Edit untuk menambahkan fitur baru di bawah ini -->
                            </StackPanel>
                        </ContentControl>
                        

                        <!-- Penutup interaksi + notice saat belum ada konten dibuka -->
                        <Border x:Name="LockOverlay"
                            Background="Transparent"
                            Visibility="Collapsed"
                            Tapped="LockOverlay_Tapped" />

                        <TeachingTip x:Name="SelectFirstTip"
                                 Title="Pilih Surah atau Juz dulu"
                                 Subtitle="Buka salah satu Surah atau Juz terlebih dahulu, baru atur tampilan."
                                 PreferredPlacement="Left"
                                 IsLightDismissEnabled="True" />

                            </Grid>

                        </Expander>
                        <!--edit salesai -->

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
