<UserControl
    x:Class="QuranKemenag.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <Grid Padding="24,16,24,24" RowSpacing="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ======================================= -->
            <!-- 1. HOME BANNER                          -->
            <!-- ======================================= -->

            <!-- HOME BANNER -->
            <Border
    Grid.Row="0"
    CornerRadius="14"
    Background="Transparent"
    BorderThickness="0"
    Padding="0"
    HorizontalAlignment="Stretch">

                <Image
        Source="ms-appx:///Assets/Images/home-banner.png"
        Stretch="Uniform"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"/>

            </Border>


            <!-- ======================================= -->
            <!-- 2. WELCOME SECTION                      -->
            <!-- ======================================= -->

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                Spacing="6"
                Margin="0,8,0,8">

                <TextBlock
                    Text="Selamat Datang di Qur’an Kemenag"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource LpmqGreenDarkBrush}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"/>

                <TextBlock
                    Text="Temukan ketenangan dengan membaca, mempelajari, dan memahami Al-Qur’an."
                    FontSize="14"
                    Foreground="{StaticResource NeutralTextSecondaryBrush}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"/>

            </StackPanel>


            <!-- ======================================= -->
            <!-- 3. MAIN ACTIVITY CARDS                  -->
            <!-- ======================================= -->

            <Grid
                Grid.Row="2"
                ColumnSpacing="16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- =================================== -->
                <!-- CONTINUE READING                    -->
                <!-- =================================== -->

                <Border
                    Grid.Column="0"
                    Background="{StaticResource LpmqGreenSoftBrush}"
                    BorderBrush="{StaticResource LpmqGreenLightBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- Reading Information -->

                        <StackPanel
                            Grid.Column="0"
                            Spacing="7">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <Border
                                    Width="48"
                                    Height="48"
                                    CornerRadius="12"
                                    Background="{StaticResource NeutralSurfaceBrush}">

                                    <FontIcon
                                        Glyph="&#xE736;"
                                        FontSize="25"
                                        Foreground="{StaticResource LpmqGreenBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="2">

                                    <TextBlock
                                        Text="Lanjutkan Bacaan"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource NeutralTextPrimaryBrush}"/>

                                    <TextBlock
                                        Text="Terakhir Anda membaca"
                                        FontSize="13"
                                        Foreground="{StaticResource NeutralTextSecondaryBrush}"/>

                                </StackPanel>

                            </StackPanel>


                            <TextBlock
                                x:Name="LastReadingSurahText"
                                Text="Belum ada bacaan"
                                FontSize="27"
                                FontWeight="Bold"
                                Foreground="{StaticResource LpmqGreenDarkBrush}"
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                x:Name="LastReadingAyatText"
                                Text="Mulai membaca Al-Qur’an"
                                FontSize="14"
                                Foreground="{StaticResource NeutralTextSecondaryBrush}"/>


                            <!-- Continue Button -->

                            <Button
                                Content="Lanjutkan Membaca    →"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Padding="22,11"
                                MinHeight="42"
                                Background="{StaticResource LpmqGreenBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Click="ContinueReadingButton_Click"/>

                        </StackPanel>


                        <!-- Decorative Icon -->

                        <FontIcon
                            Grid.Column="1"
                            Glyph="&#xE736;"
                            FontSize="76"
                            Opacity="0.10"
                            Foreground="{StaticResource LpmqGreenDarkBrush}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="8,0,4,0"/>

                    </Grid>

                </Border>


                <!-- =================================== -->
                <!-- BOOKMARK                            -->
                <!-- =================================== -->

                <Border
                    Grid.Column="1"
                    Background="{StaticResource NeutralBackgroundBrush}"
                    BorderBrush="{StaticResource LpmqGreenLightBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- Bookmark Information -->

                        <StackPanel
                            Grid.Column="0"
                            Spacing="7">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12">

                                <Border
                                    Width="48"
                                    Height="48"
                                    CornerRadius="12"
                                    Background="{StaticResource LpmqGreenSoftBrush}">

                                    <FontIcon
                                        Glyph="&#xE734;"
                                        FontSize="25"
                                        Foreground="{StaticResource LpmqGreenBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="2">

                                    <TextBlock
                                        Text="Bookmark"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource NeutralTextPrimaryBrush}"/>

                                    <TextBlock
                                        Text="Ayat yang Anda simpan"
                                        FontSize="13"
                                        Foreground="{StaticResource NeutralTextSecondaryBrush}"/>

                                </StackPanel>

                            </StackPanel>


                            <TextBlock
                                x:Name="BookmarkCountText"
                                Text="0"
                                FontSize="34"
                                FontWeight="Bold"
                                Foreground="{StaticResource LpmqGreenDarkBrush}"
                                Margin="0,8,0,0"/>

                            <TextBlock
                                Text="bookmark"
                                FontSize="14"
                                Foreground="{StaticResource NeutralTextSecondaryBrush}"/>


                            <!-- Bookmark Button -->

                            <Button
                                Content="Lihat Bookmark    →"
                                Click="ViewBookmarksButton_Click"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Padding="22,11"
                                MinHeight="42"
                                Background="{StaticResource NeutralSurfaceBrush}"
                                Foreground="{StaticResource LpmqGreenDarkBrush}"
                                BorderBrush="{StaticResource LpmqGreenBrush}"
                                BorderThickness="1"/>

                        </StackPanel>


                        <!-- Decorative Bookmark Icon -->

                        <FontIcon
                            Grid.Column="1"
                            Glyph="&#xE734;"
                            FontSize="76"
                            Opacity="0.10"
                            Foreground="{StaticResource LpmqGreenBrush}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="8,0,4,0"/>

                    </Grid>

                </Border>

            </Grid>


            <!-- ======================================= -->
            <!-- HIDDEN SEARCH CONTROL                   -->
            <!-- Keep for existing code-behind references -->
            <!-- ======================================= -->

            <TextBox
                x:Name="HomeSearchBox"
                Visibility="Collapsed"
                Width="0"
                Height="0"
                IsTabStop="False"/>

        </Grid>

    </ScrollViewer>

</UserControl>
