<UserControl
    x:Class="QuranKemenag.Views.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource LpmqGreenDarkBrush}" Padding="12,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Info kiri: Mode, Surah, Ayah, Page, Zoom -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="16">
                <TextBlock Text="Mode: Computer Font" Foreground="White" FontSize="12" />
                <TextBlock Text="Surah: -" Foreground="White" FontSize="12" />
                <TextBlock Text="Ayah: -" Foreground="White" FontSize="12" />
                <TextBlock Text="Page: -" Foreground="White" FontSize="12" />
                <TextBlock Text="Zoom: 100%" Foreground="White" FontSize="12" />
            </StackPanel>

            <!-- Status kanan -->
            <TextBlock Grid.Column="1"
                       Text="Ready"
                       Foreground="White"
                       FontSize="12" />
        </Grid>
    </Border>
</UserControl>
