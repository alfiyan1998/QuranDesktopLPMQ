<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="QuranKemenag.Views.SurahView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:QuranKemenag.Converters">

    <UserControl.Resources>

        <converters:ArabicNumberConverter
        x:Key="ArabicNumberConverter"/>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <Grid
            Grid.Row="0"
            Margin="20,18,20,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Surah"
                FontSize="18"
                FontWeight="Bold"
                VerticalAlignment="Center"/>

            <TextBox
                Grid.Column="1"
                x:Name="TxtCari"
                Height="38"
                PlaceholderText="Cari nama surah..."
                VerticalAlignment="Center"
                CornerRadius="9"
                TextChanged="TxtCari_TextChanged"/>

        </Grid>


        <!-- ========================= -->
        <!-- TOGGLE SURAH / JUZ -->
        <!-- ========================= -->

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,18,0,4">

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="9">

                <StackPanel
                    Orientation="Horizontal">

                    <!-- SURAH AKTIF -->

                    <Border
                        Background="{ThemeResource LpmqGreenBrush}"
                        CornerRadius="8"
                        Padding="18,8">

                        <TextBlock
                            Text="Surah"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="SemiBold"/>

                    </Border>


                    <!-- JUZ -->

                    <Button
                        Click="JuzTab_Click"
                        Padding="18,8"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="Juz"
                        FontSize="12"
                        Opacity="0.7"/>         

                </StackPanel>

            </Border>

        </StackPanel>


        <!-- ========================= -->
        <!-- DAFTAR SURAH -->
        <!-- ========================= -->

        <ScrollViewer
            Grid.Row="2"
            Padding="24,8,24,24"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <ItemsControl
                x:Name="SurahItemsControl"
                HorizontalAlignment="Center"
                MaxWidth="1380">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>

                        <ItemsWrapGrid
                            Orientation="Horizontal"/>

                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>


                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Button
                            Tag="{Binding}"
                            Click="SurahCard_Click"
                            Background="Transparent"
                            BorderThickness="1"
                            Padding="0"
                            Margin="0,0,12,12"
                            HorizontalContentAlignment="Stretch">

                            <Border
                                Width="320"
                                Height="66"
                                Padding="12"
                                CornerRadius="11"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                PointerEntered="SurahCard_PointerEntered"
                                PointerExited="SurahCard_PointerExited">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- ========================= -->
                                    <!-- NOMOR -->
                                    <!-- ========================= -->

                                    <Border
                                        Grid.Column="0"
                                        Width="30"
                                        Height="30"
                                        VerticalAlignment="Top">

                                        <Border.Background>
                                            <ImageBrush
                                                ImageSource="/Resources/Images/bingkai-nomor-ayat.png"
                                                Stretch="Uniform"/>
                                        </Border.Background>

                                        <TextBlock
                                            Text="{Binding Id, Converter={StaticResource ArabicNumberConverter}}"
                                            FontSize="10"
                                            Foreground="#C9A45C"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>


                                    <!-- ========================= -->
                                    <!-- INFORMASI -->
                                    <!-- ========================= -->

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="10,0,8,0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="{Binding DisplayJudul}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                            MaxLines="2"/>

                                        <TextBlock
                                            FontSize="11"
                                            Opacity="0.65">

                                            <Run Text="{Binding TotalAyah}"/>
                                            <Run Text=" ayat"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding Category}"/>

                                        </TextBlock>

                                    </StackPanel>


                                    <!-- ========================= -->
                                    <!-- NAMA ARAB -->
                                    <!-- ========================= -->

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding ArabicName}"
                                        Foreground="{ThemeResource LpmqGreenBrush}"
                                        FontSize="18"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Right"
                                        FlowDirection="RightToLeft"
                                        FontFamily="/Assets/Fonts/LPMQ IsepMisbah.ttf#LPMQ Isep Misbah"/>

                                </Grid>

                            </Border>

                        </Button>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>