<UserControl
    x:Class="QuranKemenag.Views.ToolbarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource NeutralSurfaceBrush}"
            BorderBrush="{StaticResource NeutralBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Sidebar -->
                <ColumnDefinition Width="Auto"/>
                <!-- Judul -->
                <ColumnDefinition Width="Auto"/>
                <!-- Surah -->
                <ColumnDefinition Width="Auto"/>
                <!-- Nama Arab -->
                <ColumnDefinition Width="Auto"/>
                <!-- Ayat -->
                <ColumnDefinition Width="Auto"/>
                <!-- Mode Tampilan -->
                <ColumnDefinition Width="Auto"/>
                <!-- Halaman (Mushaf Page View toggle) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Language -->
                <ColumnDefinition Width="*"/>
                <!-- Search -->
                <ColumnDefinition Width="Auto"/>
                <!-- Copy -->
                <ColumnDefinition Width="Auto"/>
                <!-- Panel -->
            </Grid.ColumnDefinitions>

            <!-- Tombol Sidebar (hamburger) -->
            <Button Grid.Column="0"
                    x:Name="SidebarToggleButton"
                    Click="SidebarToggleButton_Click"
                    Content="&#xE700;"
                    FontFamily="Segoe Fluent Icons"
                    ToolTipService.ToolTip="Sidebar" />

            <!-- Judul aplikasi -->
            <TextBlock Grid.Column="1"
                       Text="The Mushaf"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource LpmqGreenDarkBrush}" />

            <!-- Dropdown Surah -->
            <ComboBox Grid.Column="2"
                      x:Name="SurahComboBox"
                       Width="280"
                       Margin="8,0"
                       ItemsSource="{Binding Surahs}"
                      SelectedItem="{Binding SelectedSurah, Mode=TwoWay}"
                      DisplayMemberPath="LatinName"
                      IsTextSearchEnabled="True"
                      PlaceholderText="Surah" />

            <!-- Nama Arab Surah (di sebelah kanan ComboBox) -->
            <TextBlock Grid.Column="3"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedSurah.ArabicName}" />

            <!-- Dropdown Ayah -->
            <ComboBox Grid.Column="4"
                      x:Name="AyahComboBox"
                      Width="90"
                      Margin="4,0"
                      ItemsSource="{Binding Ayats}"
                      SelectedItem="{Binding SelectedAyat, Mode=TwoWay}"
                      DisplayMemberPath="AyahNumber"
                      PlaceholderText="Ayah" />

            <!-- Mode Tampilan -->
            <StackPanel
    Grid.Column="5"
    Orientation="Horizontal"
    VerticalAlignment="Center"
    Spacing="8"
    Margin="8,0">

                <TextBlock
        Text="Mode"
        VerticalAlignment="Center"/>

                <ComboBox
        x:Name="DisplayModeComboBox"
        Width="220"
        ItemsSource="{Binding DisplayModes}"
        SelectedItem="{Binding SelectedDisplayModeItem, Mode=TwoWay}"
        DisplayMemberPath="DisplayName"/>

            </StackPanel>

            <!-- Mode Tampilan (Ayat / Halaman) -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="8,0">
                <TextBlock Text="Mode Tampilan" VerticalAlignment="Center" />
                <ComboBox Width="120"
                          ItemsSource="{Binding QuranDisplayModes}"
                          SelectedItem="{Binding DisplayViewMode, Mode=TwoWay}" />
            </StackPanel>

            <!-- Language -->
            <ComboBox
    Grid.Column="7"
    x:Name="LanguageComboBox"
    Width="130"
    PlaceholderText="Language"/>

            <!-- Kotak pencarian -->
            <AutoSuggestBox Grid.Column="8"
                             x:Name="SearchBox"
                             PlaceholderText="Search"
                             VerticalAlignment="Center"
                             QueryIcon="Find" />

            <!-- Tombol Copy -->
            <Button Grid.Column="9"
                    Content="Copy" />

            <!-- Tombol toggle Feature Panel -->
            <Button Grid.Column="10"
                    x:Name="PanelToggleButton"
                    Click="PanelToggleButton_Click"
                    Content="&#xE71D;"
                    FontFamily="Segoe Fluent Icons"
                    ToolTipService.ToolTip="Feature Panel" />

        </Grid>
    </Border>
</UserControl>
