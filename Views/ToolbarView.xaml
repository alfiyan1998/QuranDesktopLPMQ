<UserControl
    x:Class="QuranKemenag.Views.ToolbarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource NeutralSurfaceBrush}"
            BorderBrush="{StaticResource NeutralBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <!-- 0. Sidebar -->
                <ColumnDefinition Width="Auto"/>

                <!-- 1. Judul -->
                <ColumnDefinition Width="Auto"/>

                <!-- 2. Surah -->
                <ColumnDefinition Width="Auto"/>

                <!-- 3. Nama Arab -->
                <ColumnDefinition Width="Auto"/>

                <!-- 4. Ayah -->
                <ColumnDefinition Width="Auto"/>

                <!-- 5. Mode Font -->
                <ColumnDefinition Width="Auto"/>

                <!-- 6. Mode Tampilan -->
                <ColumnDefinition Width="Auto"/>

                <!-- 7. Copy -->
                <ColumnDefinition Width="Auto"/>

                <!-- 8. Spacer -->
                <ColumnDefinition Width="*"/>

                <!-- 9. Feature Panel -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tombol Sidebar (hamburger) -->
            <Button Grid.Column="0"
                    x:Name="SidebarToggleButton"
                    Click="SidebarToggleButton_Click"
                    Content="&#xE700;"
                    FontFamily="Segoe Fluent Icons"
                    ToolTipService.ToolTip="Sidebar" />

            <!-- Judul aplikasi -->
            <TextBlock Grid.Column="1"
                       Text="The Mushaf"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource LpmqGreenDarkBrush}" />

            <!-- Dropdown Surah -->
            <ComboBox Grid.Column="2"
                  x:Name="SurahComboBox"
                  Width="280"
                  Margin="8,0"
                  ItemsSource="{Binding Surahs}"
                  SelectedItem="{Binding SelectedSurah, Mode=TwoWay}"
                  DisplayMemberPath="LatinName"
                  IsTextSearchEnabled="True"
                  PlaceholderText="Surah"
                  SelectionChanged="SurahComboBox_SelectionChanged" />

            <!-- Nama Arab Surah (di sebelah kanan ComboBox) -->
            <TextBlock Grid.Column="3"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedSurah.ArabicName}" />

            <!-- Dropdown Ayah -->
            <ComboBox Grid.Column="4"
                      x:Name="AyahComboBox"
                      Width="90"
                      Margin="4,0"
                      ItemsSource="{Binding Ayats}"
                      SelectedItem="{Binding SelectedAyat, Mode=TwoWay}"
                      DisplayMemberPath="AyahNumber"
                      PlaceholderText="Ayah" />

            <!-- Mode Tampilan -->
            <StackPanel
    Grid.Column="5"
    Orientation="Horizontal"
    VerticalAlignment="Center"
    Spacing="8"
    Margin="8,0">

                <TextBlock
        Text="Mode"
        VerticalAlignment="Center"/>

                <ComboBox
        x:Name="DisplayModeComboBox"
        Width="220"
        ItemsSource="{Binding DisplayModes}"
        SelectedItem="{Binding SelectedDisplayModeItem, Mode=TwoWay}"
        DisplayMemberPath="DisplayName"/>

            </StackPanel>

            <!-- Mode Tampilan (Ayat / Halaman) -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="8,0">
                <TextBlock Text="Mode Tampilan" VerticalAlignment="Center" />
                <ComboBox Width="120"
                          ItemsSource="{Binding QuranDisplayModes}"
                          SelectedItem="{Binding DisplayViewMode, Mode=TwoWay}" />
            </StackPanel>

           

            <!-- Tombol Copy -->
            <Button
                Grid.Column="7"
                x:Name="CopyButton"
                Content="Copy"
                ToolTipService.ToolTip="Salin ayat"
                Click="CopyButton_Click" />

            <!-- Tombol toggle Feature Panel -->
            <Button
                Grid.Column="9"
                x:Name="PanelToggleButton"
                Click="PanelToggleButton_Click"
                Content="&#xE71D;"
                FontFamily="Segoe Fluent Icons"
                HorizontalAlignment="Right"
                ToolTipService.ToolTip="Tampilkan/Sembunyikan Feature Panel" />

        </Grid>
    </Border>
</UserControl>
