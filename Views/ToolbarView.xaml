<UserControl
    x:Class="QuranKemenag.Views.ToolbarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource NeutralSurfaceBrush}"
            BorderBrush="{StaticResource NeutralBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
        <Grid ColumnSpacing="12" SizeChanged="ToolbarGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <!-- 0. Sidebar -->
                <ColumnDefinition Width="Auto"/>

                <!-- 1. Judul -->
                <ColumnDefinition Width="Auto"/>

                <!-- 2. Surah -->
                <ColumnDefinition Width="Auto"/>

                <!-- 3. Nama Arab -->
                <ColumnDefinition Width="Auto"/>

                <!-- 4. Ayah -->
                <ColumnDefinition Width="Auto"/>

                <!-- 5. Mode Font -->
                <ColumnDefinition Width="Auto"/>

                <!-- 7. Mode Tampilan -->
                <ColumnDefinition Width="Auto"/>

                <!-- 7. Copy -->
                <ColumnDefinition Width="Auto"/>

                <!-- 8. Spacer -->
                <ColumnDefinition Width="*"/>

                <!-- 9. Feature Panel -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tombol Sidebar (hamburger)
            <Button Grid.Column="0"
                    x:Name="SidebarToggleButton"
                    Click="SidebarToggleButton_Click"
                    Content="&#xE700;"
                    FontFamily="Segoe Fluent Icons"
                    ToolTipService.ToolTip="Sidebar" />
             -->

            <!-- Judul aplikasi -->
            <TextBlock Grid.Column="1"
                       Text="Mushaf"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource LpmqGreenDarkBrush}" />

            <!-- Dropdown Surah -->
            <ComboBox Grid.Column="2"
                  x:Name="SurahComboBox"
                  Width="280"
                  Margin="8,0"
                  ItemsSource="{Binding Surahs}"
                  SelectedItem="{Binding SelectedSurah, Mode=TwoWay}"
                  DisplayMemberPath="LatinName"
                  IsTextSearchEnabled="True"
                  PlaceholderText="Surah"
                  SelectionChanged="SurahComboBox_SelectionChanged"
                  DropDownOpened="SurahComboBox_DropDownOpened"/>

            <!-- Nama Arab Surah (di sebelah kanan ComboBox) -->
            <TextBlock Grid.Column="3"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedSurah.ArabicName}" />

            <!-- Dropdown Ayah (navigation list for the selected Surah) -->
            <ComboBox Grid.Column="4"
                      x:Name="AyahComboBox"
                      Width="90"
                      Margin="4,0"
                      ItemsSource="{Binding SurahAyats}"
                      SelectedValuePath="AyatNumber"
                      SelectedValue="{Binding SelectedAyatNumber, Mode=TwoWay}"
                      DisplayMemberPath="AyatNumber"
                      PlaceholderText="Ayat" 
                      DropDownOpened="GuardedComboBox_DropDownOpened"/>

            <!-- Mode Tampilan -->
            <StackPanel x:Name="ModePanel"
    Grid.Column="5"
    Orientation="Horizontal"
    VerticalAlignment="Center"
    Spacing="8"
    Margin="8,0">

                <TextBlock
        Text="Mode"
        VerticalAlignment="Center"/>

                <ComboBox
        x:Name="DisplayModeComboBox"
        Width="220"
        ItemsSource="{Binding DisplayModes}"
        SelectedItem="{Binding SelectedDisplayModeItem, Mode=TwoWay}"
        DisplayMemberPath="DisplayName"
        DropDownOpened="GuardedComboBox_DropDownOpened"/>

            </StackPanel>

            <!-- Mode Tampilan (Ayat / Halaman) -->
            <StackPanel x:Name="ModeTampilanPanel" Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="8,0">
                <TextBlock Text="Mode Tampilan" VerticalAlignment="Center" />
                <ComboBox x:Name="DisplayViewModeComboBox"
                          Width="120"
                          ItemsSource="{Binding QuranDisplayModes}"
                          SelectedItem="{Binding DisplayViewMode, Mode=TwoWay}" 
                          DropDownOpened="GuardedComboBox_DropDownOpened" />
            </StackPanel>

           

            <!-- Tombol Copy -->
            <Button
                Grid.Column="7"
                x:Name="CopyButton"
                Content="Copy"
                ToolTipService.ToolTip="Salin ayat"
                Click="CopyButton_Click" />

            <!-- Overflow button for responsive small widths -->
            <Button Grid.Column="8"
                    x:Name="OverflowButton"
                    Content="⋯"
                    FontSize="18"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Padding="12" Spacing="8">

                            <StackPanel Spacing="4">
                                <TextBlock Text="Surah" />

                                <ComboBox
                                    Width="240"
                                    ItemsSource="{Binding Surahs}"
                                    SelectedItem="{Binding SelectedSurah, Mode=TwoWay}"
                                    DisplayMemberPath="LatinName"
                                    IsTextSearchEnabled="True"
                                    PlaceholderText="Surah"
                                    SelectionChanged="SurahComboBox_SelectionChanged" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Ayah" />

                                <ComboBox
                                    Width="240"
                                    ItemsSource="{Binding SurahAyats}"
                                    SelectedValuePath="AyatNumber"
                                    SelectedValue="{Binding SelectedAyatNumber, Mode=TwoWay}"
                                    DisplayMemberPath="AyatNumber"
                                    PlaceholderText="Ayah" />
                            </StackPanel>

                            <Button
                                Content="Copy"
                                HorizontalAlignment="Stretch"
                                Click="CopyButton_Click"
                                ToolTipService.ToolTip="Salin ayat" />

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Mode" VerticalAlignment="Center" />
                                <ComboBox Width="200"
                                          ItemsSource="{Binding DisplayModes}"
                                          SelectedItem="{Binding SelectedDisplayModeItem, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          DropDownOpened="GuardedComboBox_DropDownOpened"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Mode Tampilan" VerticalAlignment="Center" />
                                <ComboBox Width="200"
                                          ItemsSource="{Binding QuranDisplayModes}"
                                          SelectedItem="{Binding DisplayViewMode, Mode=TwoWay}"
                                          DropDownOpened="GuardedComboBox_DropDownOpened"/>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Tombol toggle Feature Panel -->
            <Button
                Grid.Column="9"
                x:Name="PanelToggleButton"
                Click="PanelToggleButton_Click"
                Content="&#xE71D;"
                FontFamily="Segoe Fluent Icons"
                HorizontalAlignment="Right"
                ToolTipService.ToolTip="Tampilkan/Sembunyikan Feature Panel" />

            <!-- Pesan: pilih Surah/Juz dulu -->
            <TeachingTip x:Name="SelectFirstTip"
                         Title="Pilih Surah atau Juz dulu"
                         Subtitle="Buka salah satu Surah atau Juz terlebih dahulu, baru pilih ayat atau salin."
                         PreferredPlacement="Bottom"
                         IsLightDismissEnabled="True" />

            <!-- Visual states for responsive toolbar -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveStates">
                    <!-- Wide: show Mode panels, hide overflow -->
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ModePanel.Visibility" Value="Visible" />
                            <Setter Target="ModeTampilanPanel.Visibility" Value="Visible" />
                            <Setter Target="OverflowButton.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>

                    <!-- Narrow: hide Mode panels, show overflow -->
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ModePanel.Visibility" Value="Collapsed" />
                            <Setter Target="ModeTampilanPanel.Visibility" Value="Collapsed" />
                            <Setter Target="OverflowButton.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

        </Grid>
    </Border>
</UserControl>
